#!/usr/bin/env bash

set -uo pipefail

mode="dry-run"
journal_days=""
arguments_valid=1
help_requested=0
failures=0

usage() {
    cat <<'EOF'
Usage:
  clean-system
  clean-system --dry-run
  clean-system --apply
  clean-system --apply --journal-days N

Default behavior is read-only.

Options:
  --dry-run         Show cleanup candidates without removing anything.
  --apply           Apply approved pacman and targeted user-cache cleanup.
  --journal-days N  Vacuum journals older than N days. Requires --apply.
  -h, --help        Show this help.
EOF
}

while (($# > 0)); do
    case "$1" in
        --dry-run)
            mode="dry-run"
            ;;
        --apply)
            mode="apply"
            ;;
        --journal-days)
            if (($# < 2)); then
                printf 'ARGUMENT_VALIDATION=FAIL reason=missing-journal-days\n' >&2
                arguments_valid=0
            elif [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
                printf 'ARGUMENT_VALIDATION=FAIL reason=invalid-journal-days\n' >&2
                arguments_valid=0
                shift
            else
                journal_days="$2"
                shift
            fi
            ;;
        -h|--help)
            help_requested=1
            ;;
        *)
            printf 'ARGUMENT_VALIDATION=FAIL reason=unknown-option option=%s\n' "$1" >&2
            arguments_valid=0
            ;;
    esac

    shift
done

if ((help_requested == 1)); then
    usage
    exit 0
fi

if ((arguments_valid == 0)); then
    exit 2
fi

report_size() {
    local label="$1"
    local path="$2"
    local size=""

    if [[ ! -e "$path" ]]; then
        printf '%s=ABSENT path=%s\n' "$label" "$path"
        return
    fi

    size="$(
        du -sh "$path" 2>/dev/null |
            tail -n 1 |
            awk '{print $1}'
    )"

    printf '%s=%s path=%s\n' \
        "$label" "${size:-UNKNOWN}" "$path"
}

run_step() {
    local label="$1"
    shift

    if "$@"; then
        printf '%s=PASS\n' "$label"
    else
        printf '%s=FAIL\n' "$label" >&2
        ((failures += 1))
    fi
}

if ((arguments_valid == 1)); then
    printf 'MODE=%s\n' "$mode"

    printf '\n===== CURRENT STATE =====\n'
    journalctl --disk-usage 2>&1 || true
    report_size "PACMAN_CACHE_SIZE" "/var/cache/pacman/pkg"
    report_size "YAY_CACHE_SIZE" "$HOME/.cache/yay"
    report_size "USER_CACHE_SIZE" "$HOME/.cache"

    printf '\n===== PACMAN CACHE CANDIDATES =====\n'
    run_step \
        "PACCACHE_INSTALLED_DRY_RUN" \
        paccache -d -k2

    run_step \
        "PACCACHE_UNINSTALLED_DRY_RUN" \
        paccache -d -u -k0

    printf '\n===== AUR CACHE POLICY =====\n'
    printf 'AUR_CACHE_AUTOMATIC_CLEANUP=DEFERRED\n'
    printf 'AUR_CACHE_REASON=requires-package-level-review\n'

    if [[ "$mode" == "dry-run" ]]; then
        printf '\nCHANGES_APPLIED=NO\n'

        if [[ -n "$journal_days" ]]; then
            printf 'JOURNAL_VACUUM_CANDIDATE=sudo journalctl --vacuum-time=%sd\n' \
                "$journal_days"
        fi
    else
        printf '\n===== APPLY APPROVED CLEANUP =====\n'

        run_step \
            "PACCACHE_INSTALLED_APPLY" \
            sudo paccache -r -k2

        run_step \
            "PACCACHE_UNINSTALLED_APPLY" \
            sudo paccache -r -u -k0

        run_step \
            "TARGETED_USER_CACHE_APPLY" \
            rm -rf \
                "$HOME/.cache/thumbnails" \
                "$HOME/.cache/mesa_shader_cache"

        if [[ -n "$journal_days" ]]; then
            run_step \
                "JOURNAL_VACUUM_APPLY" \
                sudo journalctl --vacuum-time="${journal_days}d"
        else
            printf 'JOURNAL_VACUUM_APPLY=SKIPPED_NOT_REQUESTED\n'
        fi

        printf 'DROP_CACHES_APPLY=REJECTED_BY_POLICY\n'
        printf 'AUR_CACHE_APPLY=DEFERRED_FOR_MANUAL_REVIEW\n'
    fi

    printf '\n===== FINAL STATE =====\n'
    journalctl --disk-usage 2>&1 || true
    report_size "PACMAN_CACHE_SIZE" "/var/cache/pacman/pkg"
    report_size "YAY_CACHE_SIZE" "$HOME/.cache/yay"
    report_size "USER_CACHE_SIZE" "$HOME/.cache"

    printf '\nFAILURE_COUNT=%s\n' "$failures"

    ((failures == 0))
fi
