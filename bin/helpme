#!/usr/bin/env bash
set -euo pipefail

dotfiles_root="${DOTFILES_PUBLIC_ROOT:-$HOME/.dotfiles}"
document="$dotfiles_root/SHORTCUTS.md"

if [[ ! -r "$document" ]]; then
    printf 'helpme: dokumentasi tidak ditemukan: %s\n' "$document" >&2
    exit 1
fi

if command -v glow >/dev/null 2>&1; then
    exec glow "$document"
fi

if command -v bat >/dev/null 2>&1; then
    exec bat \
        --language=md \
        --style=plain \
        --paging=always \
        "$document"
fi

if command -v less >/dev/null 2>&1; then
    exec less "$document"
fi

exec cat "$document"
