#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
wifi — helper CLI (nmcli)

Perintah:
  wifi on                         # nyalakan radio Wi-Fi
  wifi off                        # matikan radio Wi-Fi
  wifi status                     # status perangkat & koneksi
  wifi scan                       # scan SSID di sekitar
  wifi list                       # daftar SSID (ringkas)
  wifi connect "SSID" [PASS]      # hubungkan (PASS opsional kalau open)
  wifi connect-open [SSID]        # pilih AP open (tanpa password) terkuat; bisa dibatasi SSID
  wifi disconnect                 # putuskan koneksi aktif
  wifi saved                      # daftar koneksi tersimpan
  wifi delete "SSID"              # hapus profil tersimpan SSID
  wifi ip                         # tampilkan IP saat ini
EOF
}

cmd="${1:-}"; shift || true

case "${cmd}" in
  on)
    nmcli radio wifi on
    ;;

  off)
    nmcli radio wifi off
    ;;

  status)
    echo "== Device =="
    nmcli -f DEVICE,TYPE,STATE,CONNECTION dev status
    echo
    echo "== General =="
    # Kolom yang valid untuk 'nmcli general' antara lain WIFI-HW dan WIFI
    nmcli -f WIFI-HW,WIFI general
    echo
    echo "== Active connection =="
    nmcli -f NAME,UUID,TYPE,DEVICE connection show --active
    ;;

  scan)
    nmcli dev wifi rescan
    echo "Scanning…"
    sleep 1
    nmcli -f SSID,SIGNAL,SECURITY dev wifi list | sed '1,1!b; s/SECURITY/SEC/;'
    ;;

  list)
    # Ringkas, sort berdasarkan SIGNAL menurun
    nmcli -t -f SSID,SECURITY,SIGNAL dev wifi list \
      | sort -t: -k3 -nr \
      | awk -F: 'NF{printf "%-32s  %-8s  %s%%\n",$1,$2,$3}'
    ;;

  connect)
    ssid="${1:-}"; pass="${2:-}"
    if [[ -z "${ssid}" ]]; then
      echo 'Butuh SSID. contoh: wifi connect "NamaWiFi" [password]'; exit 1
    fi
    if [[ -z "${pass}" ]]; then
      nmcli dev wifi connect "${ssid}"
    else
      nmcli dev wifi connect "${ssid}" password "${pass}"
    fi
    ;;

  connect-open)
    # usage: wifi connect-open [SSID]
    target_ssid="${1:-}"

    # Ambil daftar AP open (SECURITY == --) sebagai record "SSID:BSSID:SECURITY:SIGNAL"
    mapfile -t lines < <(nmcli -t -f SSID,BSSID,SECURITY,SIGNAL dev wifi list \
      | awk -F: '$3=="--" && $1!="" {print $0}' \
      | sort -t: -k4 -nr)

    if [[ ${#lines[@]} -eq 0 ]]; then
      echo "Tidak ada AP open (tanpa password) terdeteksi."; exit 1
    fi

    # Filter berdasarkan SSID jika diberikan
    if [[ -n "$target_ssid" ]]; then
      mapfile -t candidates < <(printf '%s\n' "${lines[@]}" \
        | awk -F: -v ss="$target_ssid" '$1==ss {print $0}')
      if [[ ${#candidates[@]} -eq 0 ]]; then
        echo "Tidak ketemu AP open untuk SSID: $target_ssid"; exit 1
      fi
      best="${candidates[0]}"
    else
      best="${lines[0]}"
    fi

    # best format: SSID:BSSID:--:SIGNAL
    IFS=':' read -r ssid bssid _ signal <<<"$best"

    echo "Menghubungkan ke open SSID: $ssid (BSSID: $bssid, sinyal: ${signal}%)"
    nmcli dev wifi connect "$ssid" bssid "$bssid" || {
      echo "Gagal connect ke $bssid. Coba BSSID lain atau jalankan 'wifi connect \"SSID\" [pass]'."; exit 1;
    }

    echo "Menunggu IP..."
    for _ in {1..10}; do
      ip_line="$(ip -4 -brief addr show | grep -E 'wlan|wl|wifi' || true)"
      if echo "$ip_line" | grep -qE '\b[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/'; then
        break
      fi
      sleep 1
    done
    [[ -n "${ip_line:-}" ]] && echo "$ip_line"

    echo "Tes ping 8.8.8.8 ..."
    if ping -c 2 -w 5 8.8.8.8 >/dev/null 2>&1; then
      echo "ICMP OK — kemungkinan akses Internet sudah tersedia."
    else
      echo "ICMP gagal — kemungkinan captive portal atau routing/DNS terbatas."
    fi

    echo "Tes HTTP ke neverssl.com untuk memicu captive portal..."
    if command -v curl >/dev/null 2>&1; then
      http_code="$(curl -I --max-time 5 -sS -L -o /dev/null -w "%{http_code}" http://neverssl.com || echo 000)"
      echo "HTTP status: $http_code"
      if [[ "$http_code" != "200" && "$http_code" != "301" && "$http_code" != "302" ]]; then
        echo "Kemungkinan captive portal atau block. Membuka browser..."
        command -v xdg-open >/dev/null 2>&1 && xdg-open "http://neverssl.com" || echo "xdg-open tidak ditemukan. Buka http://neverssl.com manual di browser."
      else
        echo "HTTP OK/Redirect — jika perlu, buka browser untuk proses portal."
      fi
    else
      echo "curl tidak tersedia. Jika captive portal tidak muncul, buka http://neverssl.com di browser."
      command -v xdg-open >/dev/null 2>&1 && xdg-open "http://neverssl.com" || true
    fi
    ;;

  disconnect)
    dev="$(nmcli -t -f DEVICE,TYPE,STATE dev | awk -F: '$2=="wifi" && $3=="connected"{print $1; exit}')"
    [[ -n "${dev:-}" ]] && nmcli dev disconnect "${dev}" || echo "Tidak ada Wi-Fi yang tersambung."
    ;;

  saved)
    nmcli -t -f NAME,UUID,TYPE connection show \
      | awk -F: '$3=="wifi" || $3=="802-11-wireless"{printf "%-32s  %s\n",$1,$2}'
    ;;

  delete)
    ssid="${1:-}"
    if [[ -z "${ssid}" ]]; then
      echo 'Butuh SSID. contoh: wifi delete "NamaWiFi"'; exit 1
    fi
    nmcli connection delete "${ssid}"
    ;;

  ip)
    ip -brief addr show | grep -E 'wlan|wl|wifi' || true
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "Perintah tidak dikenal: ${cmd}"; echo; usage; exit 1
    ;;
esac
