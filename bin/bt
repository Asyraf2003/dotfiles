#!/usr/bin/env bash

MAC="A8:99:DC:5F:79:C9"

case "${1:-}" in
  on)
    echo "--- Powering ON & Connecting ---"
    # Memaksa power on, lalu beri jeda 2 detik sebelum mencoba connect
    bluetoothctl power on
    sleep 2
    echo -e "trust $MAC\nconnect $MAC\nquit" | bluetoothctl
    ;;
    
  status)
    echo "--- Device Info ---"
    # Memberikan waktu 1 detik agar D-Bus sempat menarik data terbaru
    (echo "info $MAC"; sleep 1; echo "quit") | bluetoothctl | grep -E "Device|Name|Connected"
    ;;
    
  off)
    echo "--- Disconnecting ---"
    echo -e "disconnect $MAC\npower off\nquit" | bluetoothctl
    ;;

  *)
    echo "Usage: bt on | bt off | bt status"
    ;;
esac
